{
  "name": "hush",
  "version": "0.1.0",
  "description": "A clean, lightweight, reading-first desktop app for learning and discussing with AI",
  "author": "HiYang06",
  "license": "MIT",
  "homepage": "https://hiyang06.github.io/hush/",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiYang06/hush.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "icons": "electron scripts/make-icons.mjs",
    "build:ios-web": "vite build --config vite.ios.config.ts",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "release": "scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "better-sqlite3": "^13.0.3",
    "node-diff3": "^3.2.1",
    "openai": "^7.43.0"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.4.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "docx-preview": "^0.4.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "hast-util-from-dom": "^5.0.1",
    "hast-util-to-mdast": "^10.1.2",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "katex": "^0.16.21",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "mammoth": "^1.13.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remend": "^1.4.0",
    "shiki": "^3.2.1",
    "typescript": "^5.8.2",
    "unified": "^11.0.5",
    "vite": "^6.2.0",
    "vitest": "^5.0.5",
    "zustand": "^5.0.3"
  }
}
