# Copy to .env on the server (never commit it).
POSTGRES_PASSWORD=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=hush-storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
MAIL_FROM=Hush <login@example.com>
# Optional: attachment storage per account, in MB (default 1024).
# FILE_QUOTA_MB=1024
# Optional: login mails per 24 hours for everyone together (default 90; 0 = no limit).
# MAIL_DAILY_LIMIT=90
